    "from Bio.Seq import Seq\n",
    "\n",
    "def mutate_cds(sequence, codon_start_idx, replacement_codon):\n",
    "    return sequence[:codon_start_idx] + replacement_codon + sequence[codon_start_idx + 3:]\n",
    "\n",
    "# Generate variant CDS\n",
    "variant_cds = {\n",
    "    \"HbA\": wt_cds,\n",
    "    \"HbS\": mutate_cds(wt_cds, 18, \"GTG\"),\n",
    "    \"HbC\": mutate_cds(wt_cds, 18, \"AAG\"),\n",
    "}\n",
    "\n",
    "# Translate to stop and remove initiator Met1\n",
    "mature_chains = {\n",
    "    name: str(Seq(cds).translate(to_stop=True))[1:]\n",
    "    for name, cds in variant_cds.items()\n",
    "}\n",
    "\n",
    "# Verify expected residues at mature position 6 (0-based index 5)\n",
    "assert mature_chains[\"HbA\"][5] == \"E\"\n",
    "assert mature_chains[\"HbS\"][5] == \"V\"\n",
    "assert mature_chains[\"HbC\"][5] == \"K\"\n",
    "assert all(len(seq) == 146 for seq in mature_chains.values())\n",
    "\n",
    "df_seq = pd.DataFrame([\n",
    "    {\n",
    "        \"Variant\": name,\n",
    "        \"Codon_7\": variant_cds[name][18:21],\n",
    "        \"Mature_Res_6\": mature_chains[name][5],\n",
    "        \"Chain_Length_aa\": len(mature_chains[name]),\n",
    "    }\n",
    "    for name in [\"HbA\", \"HbS\", \"HbC\"]\n",
    "])\n",
    "display(df_seq)"
   ]
  },
