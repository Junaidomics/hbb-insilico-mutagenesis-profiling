   "source": [
    "from Bio.PDB import PDBParser\n",
    "from Bio.Data.IUPACData import protein_letters_3to1\n",
    "\n",
    "structure = PDBParser(QUIET=True).get_structure(\"1A3N\", str(pdb_path))\n",
    "chain_b = structure[0][\"B\"]\n",
    "target_res = chain_b[6]\n",
    "\n",
    "target_1letter = protein_letters_3to1[target_res.resname.capitalize()]\n",
    "assert target_1letter == \"E\", f\"Expected Glu at position 6 in PDB, found {target_res.resname}\"\n",
    "\n",
    "neighbors = []\n",
    "for res in chain_b:\n",
    "    if res.id[0] != \" \" or \"CA\" not in res or res.id[1] == target_res.id[1]:\n",
    "        continue\n",
    "    \n",
    "    distance = target_res[\"CA\"] - res[\"CA\"]\n",
    "    if distance <= 8.0:\n",
    "        aa = protein_letters_3to1[res.resname.capitalize()]\n",
    "        neighbors.append({\n",
    "            \"Neighbor\": f\"{aa}{res.id[1]}\",\n",
    "            \"PDB_Resname\": res.resname,\n",
    "            \"Cα_Distance_Å\": round(distance, 2),\n",
    "            \"Sidechain_Class\": \"Hydrophobic\" if kd_scale[aa] > 0.0 else \"Polar/Charged\"\n",
    "        })\n",
    "\n",
    "df_neighbors = pd.DataFrame(neighbors).sort_values(\"Cα_Distance_Å\")\n",
    "print(f\"✓ Native Chain B Residue 6: {target_res.resname} ({target_1letter}) | Neighbors within 8.0 Å: {len(df_neighbors)}\")\n",
    "display(df_neighbors)"
   ]
