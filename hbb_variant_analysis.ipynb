    "import matplotlib.pyplot as plt\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12.5, 4.5))\n",
    "\n",
    "# Panel A: Relative physicochemical shifts (Delta metrics)\n",
    "x_pos = range(len(physchem_df))\n",
    "width = 0.35\n",
    "\n",
    "bars1 = ax1.bar([p - width/2 for p in x_pos], physchem_df[\"Δ_Hydropathy\"], width=width, label=\"Δ Hydropathy (Kyte-Doolittle)\", color=\"#d95f02\", alpha=0.9)\n",
    "bars2 = ax1.bar([p + width/2 for p in x_pos], physchem_df[\"Δ_Charge\"], width=width, label=\"Δ Formal Charge (pH 7.4)\", color=\"#7570b3\", alpha=0.9)\n",
    "\n",
    "# Direct data value annotations on bars\n",
    "for bar in bars1:\n",
    "    yval = bar.get_height()\n",
    "    if yval != 0:\n",
    "        ax1.text(bar.get_x() + bar.get_width()/2, yval + (0.2 if yval > 0 else -0.6), f\"{yval:+.1f}\", ha='center', va='bottom', fontsize=8.5, fontweight='bold')\n",
    "\n",
    "for bar in bars2:\n",
    "    yval = bar.get_height()\n",
    "    if yval != 0:\n",
    "        ax1.text(bar.get_x() + bar.get_width()/2, yval + (0.2 if yval > 0 else -0.6), f\"{yval:+.0f}\", ha='center', va='bottom', fontsize=8.5, fontweight='bold')\n",
    "\n",
    "ax1.axhline(0, color=\"black\", linestyle=\"--\", linewidth=0.8)\n",
    "ax1.set_xticks(x_pos)\n",
    "ax1.set_xticklabels(physchem_df[\"Variant\"], fontsize=10)\n",
    "ax1.set_ylabel(\"Perturbation Relative to WT (HbA)\", fontsize=10)\n",
    "ax1.set_ylim(-1.5, 9.0)\n",
    "ax1.set_title(\"A. Physicochemical Shifts at Residue 6\", fontsize=11, fontweight=\"bold\")\n",
    "ax1.legend(loc=\"upper left\", frameon=True, fontsize=8.5)\n",
    "ax1.grid(axis=\"y\", linestyle=\":\", alpha=0.6)\n",
    "\n",
    "# Panel B: Native C-alpha neighborhood distances\n",
    "bars3 = ax2.barh(df_neighbors[\"Neighbor\"], df_neighbors[\"Cα_Distance_Å\"], color=\"#1b9e77\", alpha=0.85)\n",
    "ax2.axvline(8.0, color=\"red\", linestyle=\"--\", linewidth=1, label=\"8.0 Å Threshold\")\n",
    "\n",
    "for bar in bars3:\n",
    "    xval = bar.get_width()\n",
    "    ax2.text(xval + 0.15, bar.get_y() + bar.get_height()/2, f\"{xval:.2f} Å\", ha='left', va='center', fontsize=8)\n",
    "\n",
    "ax2.set_xlabel(\"Cα Distance from Glu6 (Å)\", fontsize=10)\n",
    "ax2.set_xlim(0, 9.5)\n",
    "ax2.set_title(\"B. Native Spatial Neighborhood (1A3N Chain B)\", fontsize=11, fontweight=\"bold\")\n",
    "ax2.invert_yaxis()\n",
    "ax2.legend(loc=\"lower right\", frameon=True, fontsize=8.5)\n",
    "ax2.grid(axis=\"x\", linestyle=\":\", alpha=0.6)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
