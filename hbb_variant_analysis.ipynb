   "source": [
    "kd_scale = {\n",
    "    \"A\": 1.8, \"C\": 2.5, \"D\": -3.5, \"E\": -3.5, \"F\": 2.8, \"G\": -0.4,\n",
    "    \"H\": -3.2, \"I\": 4.5, \"K\": -3.9, \"L\": 3.8, \"M\": 1.9, \"N\": -3.5,\n",
    "    \"P\": -1.6, \"Q\": -3.5, \"R\": -4.5, \"S\": -0.8, \"T\": -0.7, \"V\": 4.2,\n",
    "    \"W\": -0.9, \"Y\": -1.3\n",
    "}\n",
    "formal_charge = {aa: 0 for aa in \"ACFGHILMNPQSTVWY\"}\n",
    "formal_charge.update({\"D\": -1, \"E\": -1, \"K\": 1, \"R\": 1})\n",
    "\n",
    "grantham_matrix = {(\"E\", \"E\"): 0, (\"E\", \"V\"): 121, (\"E\", \"K\"): 56}\n",
    "\n",
    "metrics_rows = []\n",
    "for name in [\"HbA\", \"HbS\", \"HbC\"]:\n",
    "    res = mature_chains[name][5]\n",
    "    metrics_rows.append({\n",
    "        \"Variant\": name,\n",
    "        \"Residue\": res,\n",
    "        \"Hydropathy\": kd_scale[res],\n",
    "        \"Δ_Hydropathy\": round(kd_scale[res] - kd_scale[\"E\"], 2),\n",
    "        \"Formal_Charge\": formal_charge[res],\n",
    "        \"Δ_Charge\": formal_charge[res] - formal_charge[\"E\"],\n",
    "        \"Grantham_Distance\": grantham_matrix[(\"E\", res)]\n",
    "    })\n",
    "\n",
    "physchem_df = pd.DataFrame(metrics_rows)\n",
    "display(physchem_df)"
   ]
